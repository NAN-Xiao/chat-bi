  CROSS JOIN obs
  WHERE "e"."event_date" BETWEEN obs."max_date" - 6 AND obs."max_date"
    AND "e"."event_name" = 'dragon_summon_success'
)
SELECT "触发次数", "触发人数"
FROM event_stats
LIMIT 1000


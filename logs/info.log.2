)
SELECT d.event_date AS "日期",
       d.dau AS "DAU",
       d.pdau AS "PDAU",
       coalesce(m.missing_event_users, 0) AS "飞船升级完成触发用户数"
FROM daily_metrics d
LEFT JOIN missing_event m ON m.event_date = d.event_date


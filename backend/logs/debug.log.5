ohort_dt,\n        c.dimension_1,\n        c.dimension_2,\n        b.behavior_dt,\n        <date_diff_expr>(c.cohort_dt, b.behavior_dt) AS period_offset,\n        CASE\n            WHEN b.entity_id IS NOT NULL THEN 1\n            ELSE 0\n        END AS is_matched\n    FROM cohort c\n    LEFT JOIN behavior b\n      ON c.entity_id = b.entity_id\n     AND b.behavior_dt >= c.cohort_dt\n     AND b.behavior_dt <= <mature_window_expr>\n),\naggregated AS (\n    -- 5. 指标聚合层：统一计算分母、分子和比率\n    SELECT\n        cohort_dt,\n        dimension_1,\n        dimension_2,\n        period_offset,\n        COUNT(DISTINCT entity_id) AS base_count,\n        COUNT(DISTINCT CASE WHEN is_matched = 1 THEN entity_id END) AS matched_count,\n        ROUND(\n            COUNT(DISTINCT CASE WHEN is_matched = 1 THEN entity_id END) * 100.0\n            / NULLIF(COUNT(DISTINCT entity_id), 0),\n            2\n        ) AS matched_rate\n    FROM matched\n    GROUP BY\n        cohort_dt,\n        dimension_1,\n        dimension_2,\n        period_offset\n)\nSELECT\n    cohort_dt,\n    dimension_1,\n    dimension_2,\n    period_offset,\n    base_count,\n    matched_count,\n    matched_rate\nFROM aggregated\nORDER BY\n    cohort_dt,\n    dimension_1,\n    dimension_2,\n    period_offset\nLIMIT <limit_size>;\n只能输出单个 JSON 对象：{"success":true,"sql":"SELECT ...","tables":["..."],"chart_type":"table|line|bar|column|pie|area|metric|scatter|heatmap|funnel|sankey|treemap","brief":"图表标题","intent":"一句话用户意图","message":"","advice":"","issues":[],"suggestions":[]}。', 'role': 'system'}, {'content': '诊断已通过，请生成 SQL。\n\n<diagnosis>\n{"success": true, "sql": "", "title": "按国家分组的 30 日 DAU 明细表", "chart_type": "table", "tables": ["event"], "intent": "分析过去 30 天内不同国家的每日活跃用户数（DAU）分布情况，使用 UserActive 事件的去重用户数作为活跃指标", "message": "当前配置以国家为维度、日期为时间轴，统计 UserActive 事件的去重用户数作为 DAU 指标，时间范围为最近 30 天", "advice": "计算指标别名为自定义指标，建议修改为更具业务含义的名称如 DAU；图表类型为表格但标题为趋势，如需展示趋势建议切换为折线图", "issues": [], "suggestions": ["计算指标 1：别名填「DAU」或「活跃用户数」代替「自定义指标」", "
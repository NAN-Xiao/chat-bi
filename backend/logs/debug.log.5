lay_name":"副本id"},{"json_path":"$.seasonRound","description":"当前赛季的第几轮活动","source_field":"ext","property_name":"ext.seasonRound","property_type":"数值","property_display_name":"当前赛季的第几轮活动"},{"json_path":"$.seasonId","description":"当前所处赛季序号","source_field":"ext","property_name":"ext.seasonId","property_type":"数值","property_display_name":"当前所处赛季序号"}],"event_category":"Activity","event_display_name":"GVG匹配阶段匹配结果统计"},{"event_name":"GVGSignUp","properties":[{"json_path":"$.loseCount","description":"当前赛季该联盟失败的场次数量","source_field":"ext","property_name":"ext.loseCount","property_type":"数值","property_display_name":"当前赛季该联盟失败的场次数量"},{"json_path":"$.winCount","description":"当前赛季该联盟获胜的场次数量","source_field":"ext","property_name":"ext.winCount","property_type":"数值","property_display_name":"当前赛季该联盟获胜的场次数量"},{"json_path":"$.allianceTotalPower","description":"联盟报名队伍总战力","source_field":"ext","property_name":"ext.allianceTotalPower","property_type":"文本","property_display_name":"联盟报名队伍总战力"},{"json_path":"$.subsititutesArray","description":"替补玩家UID+战斗力数组","source_field":"ext","property_name":"ext.subsititutesArray","property_type":"文本","property_display_name":"替补玩家UID+战斗力数组"},{"json_path":"$.participantsArray","description":"主力玩家UID+战斗力数组","source_field":"ext","property_name":"ext.participantsArray","property_type":"文本","property_display_name":"主力玩家UID+战斗力数组"},{"json_path":"$.allianceRank","description":"在联盟战力排行榜的排名","source_field":"ext","property_name":"ext.allianceRank","property_type":"数值","property_display_name":"在联盟战力排行榜的排名"},{"json_path":"$.selectTimeIndex","description":"副本id","source_field":"ext","property_name":"ext.selectTimeIndex","property_type":"数值","property_display_name":"副本id"},{"json_path":"$.teamId","description":"当前报名的参与队伍ID","source_field":"ext","property_name":"ext.teamId","property_type":"数值","property_display_name":"当前报名的参与队伍ID"},{"json_path":"$.seasonRound","description":"当前赛季的第几轮活动","source_field":"ext","property_name":"ext.seasonRound","property_type":"数值","proper
ohort_dt,\n        c.dimension_1,\n        c.dimension_2,\n        b.behavior_dt,\n        <date_diff_expr>(c.cohort_dt, b.behavior_dt) AS period_offset,\n        CASE\n            WHEN b.entity_id IS NOT NULL THEN 1\n            ELSE 0\n        END AS is_matched\n    FROM cohort c\n    LEFT JOIN behavior b\n      ON c.entity_id = b.entity_id\n     AND b.behavior_dt >= c.cohort_dt\n     AND b.behavior_dt <= <mature_window_expr>\n),\naggregated AS (\n    -- 5. 指标聚合层：统一计算分母、分子和比率\n    SELECT\n        cohort_dt,\n        dimension_1,\n        dimension_2,\n        period_offset,\n        COUNT(DISTINCT entity_id) AS base_count,\n        COUNT(DISTINCT CASE WHEN is_matched = 1 THEN entity_id END) AS matched_count,\n        ROUND(\n            COUNT(DISTINCT CASE WHEN is_matched = 1 THEN entity_id END) * 100.0\n            / NULLIF(COUNT(DISTINCT entity_id), 0),\n            2\n        ) AS matched_rate\n    FROM matched\n    GROUP BY\n        cohort_dt,\n        dimension_1,\n        dimension_2,\n        period_offset\n)\nSELECT\n    cohort_dt,\n    dimension_1,\n    dimension_2,\n    period_offset,\n    base_count,\n    matched_count,\n    matched_rate\nFROM aggregated\nORDER BY\n    cohort_dt,\n    dimension_1,\n    dimension_2,\n    period_offset\nLIMIT <limit_size>;\n只能输出单个 JSON 对象：{"success":true,"sql":"SELECT ...","tables":["..."],"chart_type":"table|line|bar|column|pie|area|metric|scatter|heatmap|funnel|sankey|treemap","brief":"图表标题","intent":"一句话用户意图","message":"","advice":"","issues":[],"suggestions":[]}。', 'role': 'system'}, {'content': '诊断已通过，请生成 SQL。\n\n<diagnosis>\n{"success": true, "sql": "", "title": "过去 30 天每日英雄升星和英雄升级事件次数统计", "chart_type": "table", "tables": ["event"], "intent": "按日期统计英雄养成相关事件（升星、升级）的发生次数，观察 30 天内英雄养成行为的每日趋势", "message": "配置基本正确，可生成查询，但指标别名和选中字段有优化空间", "advice": "将指标别名改为描述性名称，移除未使用的 prod 字段", "issues": [], "suggestions": ["分析指标 1：别名从「指标 1」改为「英雄升星次数」", "分析指标 2：别名从「指标 2」改为「英雄升级次数」", "已选字段：移除「产品/项目 ID event.prod」，当前未用于分组或筛选"], "raw": "```
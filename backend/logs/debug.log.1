关联\n    SELECT\n        c.entity_id,\n        c.cohort_dt,\n        c.dimension_1,\n        c.dimension_2,\n        b.behavior_dt,\n        <date_diff_expr>(c.cohort_dt, b.behavior_dt) AS period_offset,\n        CASE\n            WHEN b.entity_id IS NOT NULL THEN 1\n            ELSE 0\n        END AS is_matched\n    FROM cohort c\n    LEFT JOIN behavior b\n      ON c.entity_id = b.entity_id\n     AND b.behavior_dt >= c.cohort_dt\n     AND b.behavior_dt <= <mature_window_expr>\n),\naggregated AS (\n    -- 5. 指标聚合层：统一计算分母、分子和比率\n    SELECT\n        cohort_dt,\n        dimension_1,\n        dimension_2,\n        period_offset,\n        COUNT(DISTINCT entity_id) AS base_count,\n        COUNT(DISTINCT CASE WHEN is_matched = 1 THEN entity_id END) AS matched_count,\n        ROUND(\n            COUNT(DISTINCT CASE WHEN is_matched = 1 THEN entity_id END) * 100.0\n            / NULLIF(COUNT(DISTINCT entity_id), 0),\n            2\n        ) AS matched_rate\n    FROM matched\n    GROUP BY\n        cohort_dt,\n        dimension_1,\n        dimension_2,\n        period_offset\n)\nSELECT\n    cohort_dt,\n    dimension_1,\n    dimension_2,\n    period_offset,\n    base_count,\n    matched_count,\n    matched_rate\nFROM aggregated\nORDER BY\n    cohort_dt,\n    dimension_1,\n    dimension_2,\n    period_offset\nLIMIT <limit_size>;\n只能输出单个 JSON 对象：{"success":true,"sql":"SELECT ...","tables":["..."],"chart_type":"table|line|bar|column|pie|area|metric|scatter|heatmap|funnel|sankey|treemap","brief":"图表标题","intent":"一句话用户意图","message":"","advice":"","issues":[],"suggestions":[]}。', 'role': 'system'}, {'content': '诊断已通过，请生成 SQL。\n\n<diagnosis>\n{"success": true, "sql": "", "title": "按国家维度统计近 30 天的每用户平均收入（ARPU），计算逻辑为后端充值总金额除以当日活跃用户去重数。", "chart_type": "table", "tables": ["event"], "intent": "分析不同国家在近 30 天内的用户付费能力（ARPU），通过对比充值总额与活跃用户基数来评估各地区的变现效率。", "message": "当前配置旨在按【国家】分组，查看近 30 天内【后端充值求和】与【当日活跃去重数】的比值（即 ARPU）。", "advice": "由于公式中分子（充值）和分母（活跃）基于不同的事件类型（ServerPayLog vs UserActive），在底层 SQL
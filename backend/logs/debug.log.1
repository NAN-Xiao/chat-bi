关联\n    SELECT\n        c.entity_id,\n        c.cohort_dt,\n        c.dimension_1,\n        c.dimension_2,\n        b.behavior_dt,\n        <date_diff_expr>(c.cohort_dt, b.behavior_dt) AS period_offset,\n        CASE\n            WHEN b.entity_id IS NOT NULL THEN 1\n            ELSE 0\n        END AS is_matched\n    FROM cohort c\n    LEFT JOIN behavior b\n      ON c.entity_id = b.entity_id\n     AND b.behavior_dt >= c.cohort_dt\n     AND b.behavior_dt <= <mature_window_expr>\n),\naggregated AS (\n    -- 5. 指标聚合层：统一计算分母、分子和比率\n    SELECT\n        cohort_dt,\n        dimension_1,\n        dimension_2,\n        period_offset,\n        COUNT(DISTINCT entity_id) AS base_count,\n        COUNT(DISTINCT CASE WHEN is_matched = 1 THEN entity_id END) AS matched_count,\n        ROUND(\n            COUNT(DISTINCT CASE WHEN is_matched = 1 THEN entity_id END) * 100.0\n            / NULLIF(COUNT(DISTINCT entity_id), 0),\n            2\n        ) AS matched_rate\n    FROM matched\n    GROUP BY\n        cohort_dt,\n        dimension_1,\n        dimension_2,\n        period_offset\n)\nSELECT\n    cohort_dt,\n    dimension_1,\n    dimension_2,\n    period_offset,\n    base_count,\n    matched_count,\n    matched_rate\nFROM aggregated\nORDER BY\n    cohort_dt,\n    dimension_1,\n    dimension_2,\n    period_offset\nLIMIT <limit_size>;\n只能输出单个 JSON 对象：{"success":true,"sql":"SELECT ...","tables":["..."],"chart_type":"table|line|bar|column|pie|area|metric|scatter|heatmap|funnel|sankey|treemap","brief":"图表标题","intent":"一句话用户意图","message":"","advice":"","issues":[],"suggestions":[]}。', 'role': 'system'}, {'content': '诊断已通过，请生成 SQL。\n\n<diagnosis>\n{"success": true, "sql": "", "title": "统计过去 30 天内，美国（US）用户每日的活跃事件次数。", "chart_type": "table", "tables": ["event"], "intent": "分析美国地区用户在近 30 天内的每日活跃趋势（基于 UserActive 事件计数）。", "message": "当前配置已正确筛选国家为 US 的数据，按日期分组，并计算了 UserActive 事件的日频次，能够表达用户意图。", "advice": "建议将图表类型从表格切换为折线图或柱状图以更直观地展示趋势，并修改图表标题以体现具体分析主题。", "issues": [], "suggestions": ["图表类型：点击图表类型
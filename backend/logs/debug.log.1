关联\n    SELECT\n        c.entity_id,\n        c.cohort_dt,\n        c.dimension_1,\n        c.dimension_2,\n        b.behavior_dt,\n        <date_diff_expr>(c.cohort_dt, b.behavior_dt) AS period_offset,\n        CASE\n            WHEN b.entity_id IS NOT NULL THEN 1\n            ELSE 0\n        END AS is_matched\n    FROM cohort c\n    LEFT JOIN behavior b\n      ON c.entity_id = b.entity_id\n     AND b.behavior_dt >= c.cohort_dt\n     AND b.behavior_dt <= <mature_window_expr>\n),\naggregated AS (\n    -- 5. 指标聚合层：统一计算分母、分子和比率\n    SELECT\n        cohort_dt,\n        dimension_1,\n        dimension_2,\n        period_offset,\n        COUNT(DISTINCT entity_id) AS base_count,\n        COUNT(DISTINCT CASE WHEN is_matched = 1 THEN entity_id END) AS matched_count,\n        ROUND(\n            COUNT(DISTINCT CASE WHEN is_matched = 1 THEN entity_id END) * 100.0\n            / NULLIF(COUNT(DISTINCT entity_id), 0),\n            2\n        ) AS matched_rate\n    FROM matched\n    GROUP BY\n        cohort_dt,\n        dimension_1,\n        dimension_2,\n        period_offset\n)\nSELECT\n    cohort_dt,\n    dimension_1,\n    dimension_2,\n    period_offset,\n    base_count,\n    matched_count,\n    matched_rate\nFROM aggregated\nORDER BY\n    cohort_dt,\n    dimension_1,\n    dimension_2,\n    period_offset\nLIMIT <limit_size>;\n只能输出单个 JSON 对象：{"success":true,"sql":"SELECT ...","tables":["..."],"chart_type":"table|line|bar|column|pie|area|metric|scatter|heatmap|funnel|sankey|treemap","brief":"图表标题","intent":"一句话用户意图","message":"","advice":"","issues":[],"suggestions":[]}。', 'role': 'system'}, {'content': '诊断已通过，请生成 SQL。\n\n<diagnosis>\n{"success": true, "sql": "", "title": "查看过去 30 天美国地区每日的活跃用户数（基于 UserActive 事件计数）。", "chart_type": "table", "tables": ["event"], "intent": "统计指定时间范围内、特定国家（US）下，每日发生\'UserActive\'事件的次数，以反映日活跃情况。", "message": "当前配置基本可行，但存在字段冗余和指标定义需确认的问题。", "advice": "建议移除未使用的\'GVG 副本阶段战斗结果统计’字段，并确认‘活跃’指标是否需改为对用户 ID 去重。", "issues": [], "suggestions": ["分析指标 1：当前‘活跃’直